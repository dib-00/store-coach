# Store Coach settings: the NAMES only. Real values never go in Git.
# For local use, copy this file to .env in the repo root (.env is git-ignored) and fill it in.
# The whole setup, step by step, is in docs/DAILY-RUN.md.

# --- SECRET: never public, never in the web app, never in a NEXT_PUBLIC_ variable ---

# Project URL, https://<project-ref>.supabase.co
# Goes in: GitHub secret SUPABASE_URL, and local .env (for scripts/upload_data.py).
SUPABASE_URL=

# Service-role (secret) key. It bypasses row level security and can read the private data bucket.
# Goes in: GitHub secret SUPABASE_SERVICE_ROLE_KEY, and local .env. Nowhere else. Not in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy hook URL. Anyone who has it can trigger a rebuild, so treat it as a secret.
# Goes in: GitHub secret VERCEL_DEPLOY_HOOK_URL only.
VERCEL_DEPLOY_HOOK_URL=

# --- PUBLIC: safe in the browser; row level security limits what they can do ---

# The same project URL as above.
# Goes in: Vercel environment variable NEXT_PUBLIC_SUPABASE_URL (and web/.env.local for local dev).
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key. It can read the runs and tick an alert as done, nothing else.
# Goes in: Vercel environment variable NEXT_PUBLIC_SUPABASE_ANON_KEY (and web/.env.local for local dev).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
